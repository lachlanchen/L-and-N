    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/preferences": "^8.0.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
